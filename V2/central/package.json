{
  "name": "autohome-central",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .prettierrc.json eslint.config.js package.json package-lock.json tsconfig.json \"api/**/*.{ts,json}\" \"web/**/*.{ts,tsx,json,html}\"",
    "format:check": "prettier --check .prettierrc.json eslint.config.js package.json package-lock.json tsconfig.json \"api/**/*.{ts,json}\" \"web/**/*.{ts,tsx,json,html}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.8"
  }
}
