{
  "name": "@autohome/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:lan": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --project tsconfig.json && vite build",
    "generate:api": "openapi-ts -i ../docs/openapi.yaml -o src/api/generated --client @hey-api/client-fetch --no-log-file && prettier --write src/api/generated",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:test": "tsc --project tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^8.1.5"
  }
}
