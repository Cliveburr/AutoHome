{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--import",
        "tsx"
      ],
      "program": "${workspaceFolder}/api/src/main.ts",
      "cwd": "${workspaceFolder}/api",
      "sourceMaps": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Open Web",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}/web",
      "preLaunchTask": "web: dev"
    }
  ],
  "compounds": [
    {
      "name": "Debug Central",
      "configurations": [
        "Debug API",
        "Open Web"
      ],
      "stopAll": true
    }
  ]
}
